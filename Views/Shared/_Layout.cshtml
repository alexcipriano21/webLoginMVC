<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
            :root {
                --primary-color: #4361ee;
                --secondary-color: #3f37c9;
                --bg-gradient: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            }

            body {
                font-family: 'Inter', sans-serif;
                background: var(--bg-gradient);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                color: #2b2d42;
            }

            .navbar {
                background: rgba(255, 255, 255, 0.8) !important;
                backdrop-filter: blur(10px);
                border-bottom: 1px solid rgba(0,0,0,0.05);
            }

            .main-container {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 40px 20px;
            }

            .card-custom {
                border: none;
                border-radius: 16px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
                overflow: hidden;
                background: #ffffff;
            }

            .card-header-custom {
                padding: 2rem;
                text-align: center;
                background: transparent;
                border: none;
            }

            .btn-custom {
                padding: 12px;
                font-weight: 600;
                border-radius: 10px;
                transition: all 0.3s ease;
            }

                .btn-custom:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
                }

            .form-control {
                border-radius: 10px;
                padding: 12px;
                border: 1px solid #e0e0e0;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.15);
                    border-color: var(--primary-color);
                }

            footer {
                background: transparent;
                padding: 20px 0;
                font-size: 0.9rem;
            }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light fixed-top">
            <div class="container">
                <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <span class="px-2 py-1 bg-primary text-white rounded me-2">A</span> Login - C#
                </a>
            </div>
        </nav>
    </header>

    <div class="main-container mt-5">
        <main role="main" class="w-100">
            @RenderBody()
        </main>
    </div>

    <footer class="text-muted text-center">
        <div class="container">
            &copy; @DateTime.Now.Year — <b>Gestión Profesional</b> — <a href="#" class="text-decoration-none">Privacidad</a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>