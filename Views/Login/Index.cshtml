@{
    ViewData["Title"] = "Página Principal";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 text-primary"><i class="fas fa-check-circle"></i> ¡Aceptado!</h1>
            <p class="lead mt-3">Has iniciado sesión correctamente. Esta es tu página protegida centralizada.</p>
            <hr class="my-4">
            <a asp-controller="Login" asp-action="Login" class="btn btn-outline-danger">
                <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
            </a>
        </div>
    </div>
</div>
